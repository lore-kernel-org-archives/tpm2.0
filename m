For running integration tests on tss the Dockerfile is a good starting
point.
https://github.com/tpm2-software/tpm2-tss/blob/master/Dockerfile#L51

--- a/Dockerfile
+++ b/Dockerfile
@@ -48,7 +48,7 @@ RUN apt-get install -y \  COPY . /tmp/tpm2-tss/  WORKDIR
/tmp/tpm2-tss  RUN ./bootstrap -RUN ./configure --enable-unit
+RUN ./configure --enable-unit --enable-integration
 RUN make -j$(nproc) check
 RUN make install
 RUN ldconfig

John

